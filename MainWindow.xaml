<Window x:Class="TopDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TopDock.Controls"
        xmlns:local="clr-namespace:TopDock"
        Title="TopDock Dynamic Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}">
    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="styles/NotchStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <!-- 비서 말풍선용 얇은 스크롤바 -->
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="2" Background="#40FFFFFF"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayCircleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="circle" Width="38" Height="38" CornerRadius="19" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="circle" Property="Background" Value="#0AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="Transparent" CornerRadius="18" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 통일된 고스트 아이콘 버튼: 원형 호버 링 + 스트로크 아이콘 (모든 탭 공용) -->
        <Style x:Key="GhostIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="Transparent" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 캡슐 텍스트 버튼 (확장 뷰 하단 액션용) -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#DADADE"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#10FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppleProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ProgressBar}}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

      </ResourceDictionary>
    </Window.Resources>

    <!-- Root grid: full screen overlay.
         UseLayoutRounding — 얇은 선(볼륨 바 등)이 반픽셀에 앉아 안티에일리어싱으로 흐려지는 것을 막는다. -->
    <Grid x:Name="RootGrid" UseLayoutRounding="True">

        <!-- Notch container: centered at top -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">

            <!-- Main notch border — 배터리 상태는 테두리를 칠하지 않고 안쪽 우측 점으로 조용히 알린다. -->
            <Border x:Name="NotchBorder" Width="100" Height="38"
                    Style="{StaticResource DarkNotchStyle}"
                    MouseEnter="Notch_MouseEnter"
                    MouseLeave="Notch_MouseLeave"
                    MouseLeftButtonUp="Notch_Click"
                    PreviewMouseWheel="Notch_PreviewMouseWheel">

                <Grid x:Name="OuterContentGrid" ClipToBounds="True">

                    <Grid x:Name="MainContainer" ClipToBounds="True" VerticalAlignment="Top" Height="38">

                        <!-- Idle compact: 얼굴만. 라벨 없이 캐릭터 자체가 아일랜드 -->
                        <Grid x:Name="IdleCompactView" Opacity="0" IsHitTestVisible="False"
                              VerticalAlignment="Center" HorizontalAlignment="Center">
                            <controls:AiFace x:Name="CompactFace" Width="36" Height="25"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- AI 작업 중 아일랜드: 아이들 아일랜드와 같은 자리·같은 크기(100×38)에 눈만 둔다.
                             문구가 없으니 폭도 아이들 아일랜드 그대로 — 작업마다 노치가 늘었다 줄지 않는다.
                             상태는 같은 자리의 상태 점(AssistantStatusChip)이 색으로 말한다. -->
                        <Grid x:Name="AssistantCompactView" Opacity="0" IsHitTestVisible="False"
                              VerticalAlignment="Center" HorizontalAlignment="Center">
                            <controls:AiFace x:Name="CompactAssistantFace" Width="36" Height="25"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Notification Compact — 누가 보냈는지(칩+이름)는 작게, 할 말(제목)은 크게.
                             예전에는 앱 이름이 제목보다 컸다: 읽어야 할 문장이 뒤로 밀려 있었다. -->
                        <Grid x:Name="NotificationCompactView" Opacity="0" IsHitTestVisible="False"
                              Margin="14,0,14,0" VerticalAlignment="Center">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="NotifCompactScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="NotifCompactSlide" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Windows 알림은 앱 타일(첫 글자), AI·도구 상태는 글리프 — 같은 자리를 나눠 쓴다 -->
                            <Border x:Name="NotifCompactChip" Grid.Column="0"
                                    Width="{x:Static local:DesignTokens.TileSizeCompact}"
                                    Height="{x:Static local:DesignTokens.TileSizeCompact}"
                                    CornerRadius="{x:Static local:DesignTokens.TileRadiusCompact}"
                                    Background="{x:Static local:DesignTokens.AccentInfo}"
                                    VerticalAlignment="Center" Margin="0,-2,8,0">
                                <TextBlock x:Name="NotifCompactChipText" Text=""
                                           Foreground="{x:Static local:DesignTokens.InkPrimary}"
                                           FontSize="{x:Static local:DesignTokens.FontMarkCompact}"
                                           FontWeight="{x:Static local:DesignTokens.WeightBold}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,-1,0,0"/>
                            </Border>
                            <Path x:Name="NotifCompactIcon" Grid.Column="0"
                                  Width="11" Height="11" Stretch="Uniform"
                                  Fill="{x:Static local:DesignTokens.AccentInfo}"
                                  VerticalAlignment="Center" Margin="0,-2,8,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="NotifCompactAppText" Grid.Column="1" Text="App"
                                       Foreground="{x:Static local:DesignTokens.AccentInfo}"
                                       FontSize="{x:Static local:DesignTokens.FontKicker}"
                                       FontWeight="{x:Static local:DesignTokens.WeightSemiBold}"
                                       VerticalAlignment="Center" Margin="0,-2,9,0"/>
                            <TextBlock x:Name="NotifCompactTitleText" Grid.Column="2" Text="Message"
                                       Foreground="{x:Static local:DesignTokens.InkPrimary}"
                                       FontSize="{x:Static local:DesignTokens.FontTitleCompact}"
                                       FontWeight="{x:Static local:DesignTokens.WeightSemiBold}"
                                       VerticalAlignment="Center" Margin="0,-2,0,0" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <!-- AI 비서: 눈·입 표정과 상태 컬러를 함께 보여준다.
                             내용(얼굴·응답·입력)도 알림 카드와 같은 손짓으로 앉는다 — 상자가 자리를
                             만들고 조금 뒤에 미끄러져 들어온다(90ms). -->
                        <Grid x:Name="AssistantView" Opacity="0" IsHitTestVisible="False"
                              Margin="18,12,18,12">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="AssistantContentScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="AssistantContentSlide" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <!-- 비네트 — 중앙은 아주 옅게 밝고 가장자리는 살짝 가라앉아 공간감을 준다.
                                 클립이 사각이라 노치 밖으로 새지 않는다. -->
                            <Grid.Background>
                                <RadialGradientBrush GradientOrigin="0.5,0.38" Center="0.5,0.38"
                                                     RadiusX="0.72" RadiusY="0.86">
                                    <GradientStop Color="#0FFFFFFF" Offset="0"/>
                                    <GradientStop Color="#00000000" Offset="0.45"/>
                                    <GradientStop Color="#38000000" Offset="1"/>
                                </RadialGradientBrush>
                            </Grid.Background>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>     <!-- 얼굴 무대 -->
                                <RowDefinition Height="Auto"/>  <!-- 응답 -->
                                <RowDefinition Height="Auto"/>  <!-- 입력 -->
                            </Grid.RowDefinitions>

                            <!-- 무대 — 얼굴만. 상태는 배터리 점과 같은 자리에 있는 상태 점이 맡는다. -->
                            <controls:AiFace x:Name="AssistantFace" Grid.Row="0" Width="132" Height="96"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <!-- 응답 — 상태 무대 아래. 내용이 없으면 저절로 0 높이 -->
                            <ScrollViewer Grid.Row="1" x:Name="AssistantScroll" MaxHeight="104"
                                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                          Margin="22,8,58,0">
                                <!-- 읽을 것은 알림 본문과 같은 리듬(13 / 줄높이 19) — 줄이 촘촘하면 긴 답이 뭉텅이로 보인다 -->
                                <TextBlock x:Name="AssistantLatestResponseText" Text=""
                                           Foreground="{x:Static local:DesignTokens.InkBodyBright}"
                                           FontSize="{x:Static local:DesignTokens.FontBody}"
                                           FontWeight="{x:Static local:DesignTokens.WeightMedium}"
                                           LineHeight="{x:Static local:DesignTokens.LineBody}"
                                           LineStackingStrategy="BlockLineHeight"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>

                            <!-- 입력 -->
                            <Grid Grid.Row="2" Margin="0,14,0,0">
                                <Border x:Name="AssistantInputBorder"
                                        Background="#141416" CornerRadius="12" Padding="12,7"
                                        BorderBrush="#22FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <TextBox x:Name="AssistantInputBox"
                                                 Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                                                 CaretBrush="{x:Static local:DesignTokens.AccentInfo}"
                                                 FontSize="{x:Static local:DesignTokens.FontBody}"
                                                 FontWeight="{x:Static local:DesignTokens.WeightMedium}"
                                                 VerticalContentAlignment="Center"
                                                 KeyDown="AssistantInput_KeyDown"/>
                                        <!-- WPF TextBox엔 플레이스홀더가 없다 — 겹쳐 두고 비었을 때만 보인다 -->
                                        <TextBlock Text="지시…" Foreground="{x:Static local:DesignTokens.InkFaint}"
                                                   FontSize="{x:Static local:DesignTokens.FontBody}"
                                                   FontWeight="{x:Static local:DesignTokens.WeightMedium}"
                                                   VerticalAlignment="Center" Margin="1,0,0,0"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=AssistantInputBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <!-- beam은 입력창 다음 형제(위에 그려짐) — 안쪽 글로우가 보이게.
                                     크기가 Border와 같아야 테두리에 정확히 안착한다. -->
                                <controls:BorderBeam x:Name="InputBeam" CornerRadius="12" BorderWidth="1.2"
                                                     Strength="0.85" Speed="0.22"/>
                            </Grid>
                        </Grid>

                        <!-- AI 콘솔 우상단 미니 컨트롤 (입력 방해 없게 최상단 코너) -->
                        <StackPanel x:Name="AssistantHeaderOverlay" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,10,12,0">
                                    <Button x:Name="AssistantAiButton" Style="{StaticResource GhostIconButton}"
                                            Width="22" Height="22" Margin="0,0,2,0"
                                            Click="AssistantAiButton_Click" ToolTip="새 지시">
                                        <Path Data="M1 4 L1 10 L7 10 M3.51 15a9 9 0 1 0 2.13 -9.36L1 10"
                                              Stroke="{x:Static local:DesignTokens.IconMuted}" StrokeThickness="2.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="10" Height="10" Stretch="Uniform"/>
                                    </Button>
                                    <Button x:Name="AssistantCloseButton" Style="{StaticResource GhostIconButton}"
                                            Width="22" Height="22"
                                            Click="AssistantCloseButton_Click" ToolTip="닫기 (Esc)">                                        <Path Data="M18 6L6 18M6 6l12 12"
                                              Stroke="{x:Static local:DesignTokens.IconMuted}" StrokeThickness="2.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="10" Height="10" Stretch="Uniform"/>
                                        </Button>
                                </StackPanel>

                        <!-- Notification Expanded — 앱 타일·제목·본문의 리듬을 고정해 길이에 상관없이
                             같은 자리에 앉는다. 폭도 고정한다: 폭이 내용을 따라가면 긴 본문이
                             줄바꿈되지 않고 카드 밖으로 잘려 나간다. -->
                        <Grid x:Name="NotificationExpandedView" Opacity="0" IsHitTestVisible="False"
                              Width="320" Margin="20,18,20,18"
                              VerticalAlignment="Top" HorizontalAlignment="Left">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="NotifExpandedScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="NotifExpandedSlide" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="NotifExpandedChip"
                                            Width="{x:Static local:DesignTokens.TileSizeRegular}"
                                            Height="{x:Static local:DesignTokens.TileSizeRegular}"
                                            CornerRadius="{x:Static local:DesignTokens.TileRadiusRegular}"
                                            Background="{x:Static local:DesignTokens.AccentInfo}" VerticalAlignment="Center">
                                        <TextBlock x:Name="NotifExpandedChipText" Text=""
                                                   Foreground="{x:Static local:DesignTokens.InkPrimary}"
                                                   FontSize="{x:Static local:DesignTokens.FontMarkRegular}"
                                                   FontWeight="{x:Static local:DesignTokens.WeightBold}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="0,-1,0,0"/>
                                    </Border>
                                    <Path x:Name="NotifExpandedIcon" Width="12" Height="12" Stretch="Uniform"
                                          Fill="{x:Static local:DesignTokens.AccentInfo}" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <TextBlock x:Name="NotifExpandedAppText" Text="App Name"
                                               Foreground="{x:Static local:DesignTokens.AccentInfo}"
                                               FontSize="{x:Static local:DesignTokens.FontKickerLarge}"
                                               FontWeight="{x:Static local:DesignTokens.WeightSemiBold}"
                                               VerticalAlignment="Center" Margin="9,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="NotifExpandedTitleText" Grid.Row="1" Text="Notification Title"
                                       Foreground="{x:Static local:DesignTokens.InkPrimary}"
                                       FontSize="{x:Static local:DesignTokens.FontTitle}"
                                       FontWeight="{x:Static local:DesignTokens.WeightSemiBold}"
                                       TextWrapping="Wrap" MaxHeight="42" Margin="0,0,0,8"/>
                            <TextBlock x:Name="NotifExpandedBodyText" Grid.Row="2" Text="Body text here..."
                                       Foreground="{x:Static local:DesignTokens.InkBody}"
                                       FontSize="{x:Static local:DesignTokens.FontBody}"
                                       FontWeight="{x:Static local:DesignTokens.WeightMedium}"
                                       LineHeight="{x:Static local:DesignTokens.LineBody}"
                                       LineStackingStrategy="BlockLineHeight"
                                       TextWrapping="Wrap" MaxHeight="42" TextTrimming="WordEllipsis"/>
                        </Grid>

                        <!-- 알림 인박스 — 화면에서 걷힌 알림을 노치 안에서 다시 본다(단축키·트레이로 연다).
                             한 번에 한 건만 앉힌다: 노치 크기에서 목록은 글자를 읽기엔 좁다.
                             ↑↓·휠·클릭으로 넘기고 Delete로 지운다. -->
                        <Grid x:Name="InboxView" Opacity="0" IsHitTestVisible="False"
                              Width="380" Margin="20,16,20,16"
                              VerticalAlignment="Top" HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>   <!-- 머리: 개수·버튼 -->
                                <RowDefinition Height="*"/>      <!-- 한 건: 출처·제목·본문 -->
                                <RowDefinition Height="Auto"/>   <!-- 조작 안내 -->
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Width="11" Height="11" Stretch="Uniform"
                                          Fill="{x:Static local:DesignTokens.AccentInfo}"
                                          VerticalAlignment="Center" Margin="0,0,6,0"
                                          Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5S10.5 3.17 10.5 4v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/>
                                    <TextBlock Text="ALERTS" FontSize="{x:Static local:DesignTokens.FontSection}"
                                               FontWeight="{x:Static local:DesignTokens.WeightSemiBold}"
                                               Foreground="{x:Static local:DesignTokens.InkMuted}"
                                               VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                    <TextBlock x:Name="InboxCounterText" Text="1 / 1"
                                               FontSize="{x:Static local:DesignTokens.FontSection}"
                                               FontWeight="{x:Static local:DesignTokens.WeightSemiBold}"
                                               Foreground="{x:Static local:DesignTokens.InkFaint}"
                                               VerticalAlignment="Center" Margin="8,-1,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="InboxClearButton" Style="{StaticResource GhostIconButton}"
                                            Width="20" Height="20" Margin="0,0,2,0"
                                            Click="InboxClearButton_Click" ToolTip="기록 모두 지우기">
                                        <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                              Fill="{x:Static local:DesignTokens.InkMuted}" Width="11" Height="11" Stretch="Uniform"/>
                                    </Button>
                                    <Button x:Name="InboxCloseButton" Style="{StaticResource GhostIconButton}"
                                            Width="20" Height="20"
                                            Click="InboxCloseButton_Click" ToolTip="닫기 (Esc)">
                                        <Path Data="M18 6L6 18M6 6l12 12"
                                              Stroke="{x:Static local:DesignTokens.IconMuted}" StrokeThickness="2.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="10" Height="10" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 한 건이 통째로 움직인다 — 넘길 때 글자만 갈아끼우면 툭 바뀐 것처럼 보인다 -->
                            <Grid x:Name="InboxItemBlock" Grid.Row="1">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="InboxItemSlide" Y="0"/>
                                </Grid.RenderTransform>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>   <!-- 앱 타일 · 출처 · 언제 -->
                                    <RowDefinition Height="Auto"/>   <!-- 제목 -->
                                    <RowDefinition Height="*"/>      <!-- 본문 -->
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,7">
                                    <Border x:Name="InboxChip"
                                            Width="{x:Static local:DesignTokens.TileSizeRegular}"
                                            Height="{x:Static local:DesignTokens.TileSizeRegular}"
                                            CornerRadius="{x:Static local:DesignTokens.TileRadiusRegular}"
                                            Background="{x:Static local:DesignTokens.AccentInfo}" VerticalAlignment="Center">
                                        <TextBlock x:Name="InboxChipText" Text=""
                                                   Foreground="{x:Static local:DesignTokens.InkPrimary}"
                                                   FontSize="{x:Static local:DesignTokens.FontMarkRegular}"
                                                   FontWeight="{x:Static local:DesignTokens.WeightBold}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="0,-1,0,0"/>
                                    </Border>
                                    <TextBlock x:Name="InboxAppText" Text=""
                                               Foreground="{x:Static local:DesignTokens.AccentInfo}"
                                               FontSize="{x:Static local:DesignTokens.FontKickerLarge}"
                                               FontWeight="{x:Static local:DesignTokens.WeightSemiBold}"
                                               VerticalAlignment="Center" Margin="9,0,0,0"/>
                                    <TextBlock Text="·" Foreground="{x:Static local:DesignTokens.InkFaint}"
                                               FontSize="{x:Static local:DesignTokens.FontKicker}"
                                               Margin="6,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="InboxAgeText" Text=""
                                               Foreground="{x:Static local:DesignTokens.InkMuted}"
                                               FontSize="{x:Static local:DesignTokens.FontMeta}"
                                               FontWeight="{x:Static local:DesignTokens.WeightMedium}"
                                               VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                </StackPanel>

                                <TextBlock x:Name="InboxTitleText" Grid.Row="1" Text=""
                                           Foreground="{x:Static local:DesignTokens.InkPrimary}"
                                           FontSize="{x:Static local:DesignTokens.FontTitle}"
                                           FontWeight="{x:Static local:DesignTokens.WeightSemiBold}"
                                           TextWrapping="Wrap" MaxHeight="42" Margin="0,0,0,6"/>

                                <TextBlock x:Name="InboxBodyText" Grid.Row="2" Text=""
                                           Foreground="{x:Static local:DesignTokens.InkBody}"
                                           FontSize="{x:Static local:DesignTokens.FontBody}"
                                           FontWeight="{x:Static local:DesignTokens.WeightMedium}"
                                           LineHeight="{x:Static local:DesignTokens.LineBody}"
                                           LineStackingStrategy="BlockLineHeight"
                                           TextWrapping="Wrap" MaxHeight="46" TextTrimming="WordEllipsis"/>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="↑↓ · 휠 이동   Delete 지우기   Esc 닫기"
                                       Foreground="{x:Static local:DesignTokens.InkFaint}"
                                       FontSize="{x:Static local:DesignTokens.FontHint}"
                                       FontWeight="{x:Static local:DesignTokens.WeightMedium}" Margin="0,8,0,0"/>
                        </Grid>

                        <!-- Idle expanded: 얼굴 아래 충전/저전력 상태 배지 -->
                        <StackPanel x:Name="IdleExpandedView" Opacity="0" IsHitTestVisible="False"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <controls:AiFace x:Name="ExpandedFace" Width="58" Height="40"
                                             HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Media compact — 이제 제목과 가사만 남는다. 소리는 오른쪽 끝 링 안의 바늘이
                             말한다(예전엔 이 자리에 장식용 3바가 따로 있었고, 점이 뜨면 비켜났다).
                             링은 재생 내내 이 자리에 상주하므로 오른쪽 여백을 늘 비워 둔다 —
                             볼륨을 만질 때만 뜨던 시절의 '점이 뜨면 민다' 규칙은 필요 없다. -->
                        <Grid x:Name="MediaCompactView" Opacity="0" IsHitTestVisible="False"
                              VerticalAlignment="Center">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Margin" Value="14,0,14,0"/>
                                    <Style.Triggers>
                                        <!-- 링이 이 자리를 쓰는 동안 글자가 그 밑으로 들어가지 않게 -->
                                        <DataTrigger Binding="{Binding Visibility, ElementName=VolumeRing}" Value="Visible">
                                            <Setter Property="Margin" Value="14,0,34,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CompactTitleText" Grid.Column="0" Text="재생 중인 미디어 없음"
                                       Foreground="{x:Static local:DesignTokens.InkPrimary}"
                                       FontSize="{x:Static local:DesignTokens.FontTitleCompact}"
                                       FontWeight="{x:Static local:DesignTokens.WeightSemiBold}"
                                       LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                       VerticalAlignment="Center" Margin="0,-2,14,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="CompactLyricText" Grid.Column="1" Text=""
                                       Foreground="{x:Static local:DesignTokens.InkMuted}"
                                       FontSize="{x:Static local:DesignTokens.FontBody}"
                                       FontWeight="{x:Static local:DesignTokens.WeightMedium}"
                                       LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Margin="0,-2,0,0" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <!-- Media expanded -->
                        <Grid x:Name="MediaExpandedView" Opacity="0" IsHitTestVisible="False"
                              Margin="20,20,20,20" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="PlayerCol" Width="390"/>
                                <ColumnDefinition x:Name="LyricsDividerCol" Width="Auto"/>
                                <ColumnDefinition x:Name="LyricsCol" Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 2단 — 아트·제목·컨트롤을 한 줄에 모은다.
                                     예전 3단(아트/진행바/컨트롤)은 내용보다 카드가 세로로 길었다. -->
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="54" Height="54" CornerRadius="14"
                                            Margin="0,0,12,0" VerticalAlignment="Center"
                                            BorderBrush="#25FFFFFF" BorderThickness="0.5">
                                        <!-- 썸네일을 안 주는 플레이어(브라우저 강의 등)에서는 이 자리 표시가 계속 남는다.
                                             예전엔 앨범 브랜드 빨강(음표)이라 노치의 무채색 언어에서 혼자 튀었다 —
                                             이제 조용한 그라데이션 타일 위의 반투명 음표로 비워 둔다. -->
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#2C2C31" Offset="0"/>
                                                <GradientStop Color="#161618" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.OpacityMask>
                                            <VisualBrush>
                                                <VisualBrush.Visual>
                                                    <Border Width="54" Height="54" CornerRadius="14" Background="Black"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Border.OpacityMask>
                                        <Grid>
                                            <Image x:Name="ExpandedAlbumArtImage" Stretch="UniformToFill"/>
                                            <Path x:Name="ExpandedDefaultIcon"
                                                  Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                                  Fill="#59FFFFFF" Width="23" Height="23" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock x:Name="ExpandedTitleText" Text="재생 중인 미디어 없음"
                                                   Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="ExpandedArtistText" Text="" Foreground="#98989D"
                                                   FontSize="12" FontWeight="Medium"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- 재생 조작만 남겨 헤더를 가볍게 정리 -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource AppleButton}" Click="PrevButton_Click"
                                                Width="32" Height="32" Margin="0,0,14,0">
                                            <Path Data="M6 6h2v12H6zm3.5 6l8.5 6V6z"
                                                  Fill="#FFFFFF" Width="15" Height="15" Stretch="Uniform"/>
                                        </Button>
                                        <Button Style="{StaticResource PlayCircleButton}" Click="PlayPauseButton_Click"
                                                Width="38" Height="38" Margin="0,0,14,0" Cursor="Hand">
                                            <Path x:Name="PlayPauseIcon" Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z"
                                                  Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <Button Style="{StaticResource AppleButton}" Click="NextButton_Click"
                                                Width="32" Height="32">
                                            <Path Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"
                                                  Fill="#FFFFFF" Width="15" Height="15" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Progress bar -->
                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- 진행바 위의 투명한 14px 히트존 — 클릭/드래그로 탐색.
                                         음수 마진으로 실제 차지 높이는 4px 그대로 유지한다. -->
                                    <Grid Grid.Row="0" Height="14" Margin="0,-5,0,-5"
                                          Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonDown="SeekBar_MouseLeftButtonDown"
                                          MouseMove="SeekBar_MouseMove"
                                          MouseLeftButtonUp="SeekBar_MouseLeftButtonUp">
                                        <ProgressBar x:Name="ExpandedProgressBar"
                                                     Style="{StaticResource AppleProgressBar}"
                                                     Height="4" VerticalAlignment="Center" IsHitTestVisible="False"
                                                     Minimum="0" Maximum="100" Value="0"/>
                                    </Grid>
                                    <!-- 시간 줄 -->
                                    <Grid x:Name="ExpandedTimeRow" Grid.Row="1" Margin="0,6,0,0">
                                        <TextBlock x:Name="CurrentTimeText" Text="0:00"
                                                   Foreground="{x:Static local:DesignTokens.InkMuted}"
                                                   FontSize="{x:Static local:DesignTokens.FontSection}"
                                                   FontWeight="{x:Static local:DesignTokens.WeightSemiBold}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TotalTimeText" Text="0:00"
                                                   Foreground="{x:Static local:DesignTokens.InkMuted}"
                                                   FontSize="{x:Static local:DesignTokens.FontSection}"
                                                   FontWeight="{x:Static local:DesignTokens.WeightSemiBold}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>

                            </Grid>

                            <Rectangle x:Name="LyricsDivider" Grid.Column="1"
                                       Fill="#12FFFFFF" Width="1" Margin="16,10,18,10" Visibility="Collapsed"/>

                            <!-- 가사 조회 중에도 예약된 영역을 비워두지 않고 조용한 상태 안내를 보여준다. -->
                            <StackPanel x:Name="LyricsLoadingPanel" Grid.Column="2" VerticalAlignment="Center"
                                        Margin="4,0,18,0" Visibility="Collapsed">
                                <TextBlock Text="LYRICS" Foreground="#C69A6B" FontSize="9"
                                           FontWeight="Bold" Margin="0,0,0,7"/>
                                <TextBlock Text="가사를 찾고 있어요" Foreground="#E8E5E1" FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="잠시만 기다려 주세요" Foreground="#77777C" FontSize="11"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Grid x:Name="LyricsContainer" Grid.Column="2" VerticalAlignment="Center" Visibility="Collapsed">
                                <StackPanel x:Name="LyricsPanel">
                                    <TextBlock x:Name="PrevLyricText" Text="" Foreground="#555558"
                                               FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6"/>
                                    <TextBlock x:Name="CurrentLyricText" Text="" Foreground="#FFFFFF"
                                               FontSize="15" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="44"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="NextLyricText" Text="" Foreground="#88888C"
                                               FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>

                        </Grid>

                    </Grid>

                    <!-- 볼륨 링 — 오른쪽 끝 자리의 주인. 볼륨을 만드는 동안에도, 소리가 흐르는 동안에도
                         떠 있다(재생 중엔 안쪽 세 칸이 지금 나는 소리를 그린다). 상태 점이 뜨면
                         바늘만 비켜선다 — 자리를 양보하는 것은 호가 아니다.
                         진행바를 쓰지 않으므로 재생 위치를 가리지 않는다. 상태 점과 같은 중심에 두어
                         (점 중심 = 오른쪽 18px) 링이 점을 감싸 보이게 한다. -->
                    <controls:VolumeRing x:Name="VolumeRing" Width="24" Height="24"
                                         HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Margin="0,0,6,0"
                                         Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                                         RenderTransformOrigin="0.5,0.5">
                        <controls:VolumeRing.RenderTransform>
                            <ScaleTransform x:Name="VolumeRingScale" ScaleX="1" ScaleY="1"/>
                        </controls:VolumeRing.RenderTransform>
                    </controls:VolumeRing>

                    <!-- 공용 상태 점 자리 — 오른쪽 끝에서 12px, 12×12 후광 + 5×5 코어.
                         배터리도 AI도 이 한 자리만 쓴다. 위치가 하나라 화면이 바뀌어도 눈이 옮겨 다니지 않는다.
                           배터리: 일반=안 그림 / 충전 중=녹색 + 은은한 pulse / 부족=적색 고정
                           AI:     생각=보라 / 실행=주황 / 응답=파랑 / 완료=초록 (글씨 없음) -->
                    <Grid x:Name="BatteryDot" Width="12" Height="12"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,12,0" Visibility="Collapsed" IsHitTestVisible="False">
                        <Ellipse x:Name="BatteryDotGlow" Width="12" Height="12"
                                 Opacity="0.3" Fill="{x:Static local:DesignTokens.AccentCharging}"/>
                        <Ellipse x:Name="BatteryDotCore" Width="5" Height="5"
                                 Fill="{x:Static local:DesignTokens.AccentCharging}"/>
                    </Grid>

                    <!-- AI 상태 점 — 배터리 점과 같은 자리·같은 크기. 색과 숨쉬는 빛만으로 상태를 말한다.
                         색은 코드가 상태에 맞춰 끼운다 (ApplyAssistantIndicator). -->
                    <Grid x:Name="AssistantStatusChip" Width="12" Height="12"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,12,0" Visibility="Collapsed" IsHitTestVisible="False">
                        <Ellipse x:Name="AssistantStatusGlow" Width="12" Height="12"
                                 Opacity="0.3" Fill="{x:Static local:DesignTokens.AiThinkingBrush}"/>
                        <Ellipse x:Name="AssistantStatusCore" Width="5" Height="5"
                                 Fill="{x:Static local:DesignTokens.AiThinkingBrush}"/>
                    </Grid>

                    <!-- 복사 피드백: 노치 안쪽 우측에 잠깐 스며드는 타일.
                         별도 창(캡슐)을 띄우지 않고 아일랜드 안에서만 알린다.
                         모양은 알림의 앱 타일과 같다 — 같은 자리에 같은 모양의 타일이 앉지만
                         안에 드는 것이 다르다: 복사는 앱이 아니라 '방금 생긴 일'이라 글리프를 쓴다.
                         타일 18 + 오른쪽 여백 9 = 중심이 오른쪽 끝에서 18px — 배터리·AI 점과 같은 중심. -->
                    <Border x:Name="ClipboardFeedbackChip"
                            Width="{x:Static local:DesignTokens.TileSizeCompact}"
                            Height="{x:Static local:DesignTokens.TileSizeCompact}"
                            CornerRadius="{x:Static local:DesignTokens.TileRadiusCompact}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                            Background="{x:Static local:DesignTokens.AccentInfo}"
                            Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ClipboardFeedbackScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                              Fill="{x:Static local:DesignTokens.InkPrimary}"
                              Width="{x:Static local:DesignTokens.FontMarkCompact}"
                              Height="{x:Static local:DesignTokens.FontMarkCompact}" Stretch="Uniform"/>
                    </Border>

                </Grid>
            </Border>

            <!-- 본체 '위'에 얹히는 오버레이: 원본 beam은 콘텐츠 위에서 빛나므로
                 안쪽으로 퍼지는 글로우가 보인다. NotchBorder 뒤에 두면 inner 레이어가 가려진다. -->
            <controls:BorderBeam x:Name="NotchBeam" Width="100" Height="38"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 CornerRadius="19" BorderWidth="1.2" Strength="1.0" Active="True"/>
        </Grid>

        <!-- 클립보드 기록 패널: 노치 아래 중앙에 내려온다 (Ctrl+Shift+V 또는 노치 클릭)
             폭은 고정한다 — 폭이 내용을 따라가면 복사할 때마다 카드가 늘었다 줄었다 한다
             (알림 카드에서 같은 이유로 폭을 고정했다). -->
        <Canvas IsHitTestVisible="True">
            <Border x:Name="ClipboardHistoryPanel" Canvas.Left="0" Canvas.Top="0"
                    Width="320" CornerRadius="14"
                    Background="#0C0C0E" BorderThickness="1"
                    Style="{StaticResource DarkNotchStyle}"
                    RenderTransformOrigin="0,0"
                    Visibility="Collapsed" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ClipboardHistoryTransform" Y="0"/>
                </Border.RenderTransform>
                <StackPanel>
                    <!-- 머리 — 인박스와 같은 리듬: 작은 글리프 + 이름표. 두 패널이 다른 머리를 쓰면
                         같은 앱의 두 목록이 아니라 서로 다른 도구처럼 보인다. -->
                    <Grid Margin="12,8,6,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Path Width="11" Height="11" Stretch="Uniform"
                                  Fill="{x:Static local:DesignTokens.AccentInfo}"
                                  VerticalAlignment="Center" Margin="0,0,6,0"
                                  Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
                            <TextBlock Text="CLIPBOARD" FontSize="{x:Static local:DesignTokens.FontSection}"
                                       FontWeight="{x:Static local:DesignTokens.WeightSemiBold}"
                                       Foreground="{x:Static local:DesignTokens.InkMuted}"
                                       VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </StackPanel>
                        <Button x:Name="ClipboardClearButton" Style="{StaticResource GhostIconButton}"
                                Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="ClipboardClearButton_Click" ToolTip="기록 모두 지우기">
                            <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                  Fill="{x:Static local:DesignTokens.InkMuted}" Width="11" Height="11" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                    <!-- 목록은 머리 뒤에 정착한다 — 상자와 내용이 같은 프레임에 나타나면 툭 튀어나온 것처럼 보인다 -->
                    <StackPanel x:Name="ClipboardHistoryRows" Margin="6" Opacity="0">
                        <StackPanel.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ClipboardRowsScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="ClipboardRowsSlide" Y="0"/>
                            </TransformGroup>
                        </StackPanel.RenderTransform>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
