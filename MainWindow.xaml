<Window x:Class="TopDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TopDock.Controls"
        Title="TopDock Dynamic Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">
    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="styles/NotchStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <!-- 비서 말풍선용 얇은 스크롤바 -->
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="2" Background="#40FFFFFF"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayCircleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="circle" Width="38" Height="38" CornerRadius="19" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="circle" Property="Background" Value="#0AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClipRowStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AppleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="Transparent" CornerRadius="18" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 통일된 고스트 아이콘 버튼: 원형 호버 링 + 스트로크 아이콘 (모든 탭 공용) -->
        <Style x:Key="GhostIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="Transparent" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 캡슐 텍스트 버튼 (확장 뷰 하단 액션용) -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#DADADE"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, -apple-system"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#10FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppleProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ProgressBar}}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppleVolumeProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="#252528"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ProgressBar}}" CornerRadius="4"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
      </ResourceDictionary>
    </Window.Resources>

    <!-- Root grid: full screen overlay -->
    <Grid x:Name="RootGrid">

        <!-- Notch container: centered at top -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">

            <!-- Main notch border — 배터리 상태는 테두리를 칠하지 않고
                 안쪽 우측의 작은 점(BatteryDot)과 펼침 뷰의 퍼센트 텍스트로만 알린다. -->
            <Border x:Name="NotchBorder" Width="100" Height="38"
                    Style="{StaticResource DarkNotchStyle}"
                    MouseEnter="Notch_MouseEnter"
                    MouseLeave="Notch_MouseLeave"
                    PreviewMouseWheel="Notch_PreviewMouseWheel">

                <Grid x:Name="OuterContentGrid" ClipToBounds="True">

                    <Grid x:Name="MainContainer" ClipToBounds="True" VerticalAlignment="Top" Height="38">

                        <!-- Volume HUD -->
                        <Grid x:Name="VolumeHudView" Opacity="0" IsHitTestVisible="False"
                              Margin="14,0,14,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="VolumeIcon" Grid.Column="0"
                                  Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"
                                  Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <ProgressBar x:Name="VolumeProgressBar" Grid.Column="1"
                                         Style="{StaticResource AppleVolumeProgressBar}"
                                         Height="8" Minimum="0" Maximum="100" Value="50" VerticalAlignment="Center"/>
                            <TextBlock x:Name="VolumeText" Grid.Column="2" Text="50%"
                                       Foreground="#E5FFFFFF" FontSize="11" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system"/>
                        </Grid>

                        <!-- Idle compact: 얼굴만. 라벨 없이 캐릭터 자체가 아일랜드 -->
                        <Grid x:Name="IdleCompactView" Opacity="0" IsHitTestVisible="False"
                              VerticalAlignment="Center" HorizontalAlignment="Center">
                            <controls:AiFace x:Name="CompactFace" Width="36" Height="25"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Notification Compact -->
                        <Grid x:Name="NotificationCompactView" Opacity="0" IsHitTestVisible="False"
                              Margin="14,0,14,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NotifCompactAppText" Grid.Column="0" Text="App"
                                       Foreground="#0A84FF" FontSize="13.5" FontWeight="Bold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system"
                                       VerticalAlignment="Center" Margin="0,-2,10,0"/>
                            <TextBlock x:Name="NotifCompactTitleText" Grid.Column="1" Text="Message"
                                       Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system"
                                       VerticalAlignment="Center" Margin="0,-2,0,0" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <!-- AI 비서: 지시 콘솔 — 사고 중엔 오브가 중앙, 응답 시작 시 상단으로 물러난다 -->
                        <DockPanel x:Name="AssistantView" Opacity="0" IsHitTestVisible="False"
                                   Margin="16,12,16,12" LastChildFill="True">

                            <!-- 하단 고정: 입력창 -->
                            <Grid DockPanel.Dock="Bottom">
                                <Border x:Name="AssistantInputBorder"
                                        Background="#141416" CornerRadius="10" Padding="10,6"
                                        Margin="0,8,0,0" BorderBrush="#22FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <TextBox x:Name="AssistantInputBox"
                                                 Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                                                 CaretBrush="#0A84FF" FontSize="13" FontWeight="Medium"
                                                 FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system"
                                                 VerticalContentAlignment="Center"
                                                 KeyDown="AssistantInput_KeyDown"/>
                                    </Grid>
                                </Border>
                                <!-- beam은 입력창 다음 형제(위에 그려짐) — 안쪽 글로우가 보이게.
                                     Margin은 Border와 동일해야 테두리에 정확히 안착한다. -->
                                <controls:BorderBeam x:Name="InputBeam" CornerRadius="10" BorderWidth="1.2"
                                                     Strength="0.85" Speed="0.22" Margin="0,8,0,0"/>
                            </Grid>

                            <!-- 응답: 오브·상태 헤더 아래에 배치되어 겹치지 않는다 -->
                            <StackPanel>
                                <!-- 오브+상태 헤더 (응답 흐름 위 한 줄) -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <controls:ThinkingOrb x:Name="ConversationOrb" Width="38" Height="38"
                                                          Kind="Breathing" Ink="#F2F2F7"
                                                          VerticalAlignment="Center"
                                                          Visibility="Collapsed"/>
                                    <TextBlock x:Name="AssistantStatusText" Text=""
                                               VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="240"
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system">
                                        <TextBlock.Foreground>
                                            <!-- 원작 디테일: 흐린 잉크 위로 밝은 빛이 스치는 광택 스윕 -->
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"
                                                                 MappingMode="RelativeToBoundingBox">
                                                <GradientStop Color="#8E8E93" Offset="0"/>
                                                <GradientStop x:Name="StatusSheenBright" Color="#FFFFFF" Offset="0.5"/>
                                                <GradientStop Color="#8E8E93" Offset="1"/>
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>

                                <!-- 사고 중 전용 중앙 오브: 지시 입력 직후 크게 표시, 첫 응답 조각 오면 숨김 -->
                                <controls:ThinkingOrb x:Name="CenterOrb" Width="72" Height="72"
                                                      Kind="Working" Ink="#F2F2F7"
                                                      HorizontalAlignment="Center" Margin="0,8,0,8"
                                                      Visibility="Collapsed"/>

                                <ScrollViewer x:Name="AssistantScroll"
                                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="AssistantLatestResponseText" Text=""
                                               Foreground="#E8FFFFFF" FontSize="13" FontWeight="Medium"
                                               TextWrapping="Wrap"
                                               FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system"/>
                                </ScrollViewer>
                            </StackPanel>
                        </DockPanel>

                        <!-- AI 콘솔 우상단 미니 컨트롤 (입력 방해 없게 최상단 코너) -->
                        <StackPanel x:Name="AssistantHeaderOverlay" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,10,12,0">
                                    <Button x:Name="AssistantAiButton" Style="{StaticResource GhostIconButton}"
                                            Width="22" Height="22" Margin="0,0,2,0"
                                            Click="AssistantAiButton_Click" ToolTip="새 지시">
                                        <Path Data="M1 4 L1 10 L7 10 M3.51 15a9 9 0 1 0 2.13 -9.36L1 10"
                                              Stroke="#A8A8AD" StrokeThickness="2.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="10" Height="10" Stretch="Uniform"/>
                                    </Button>
                                    <Button x:Name="AssistantSettingsButton" Style="{StaticResource GhostIconButton}"
                                            Width="22" Height="22" Margin="0,0,2,0"
                                            Click="AssistantSettingsButton_Click" ToolTip="설정">
                                        <Path Data="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
                                              Stroke="#A8A8AD" StrokeThickness="2.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="10" Height="10" Stretch="Uniform"/>
                                    </Button>
                                    <Button x:Name="AssistantCloseButton" Style="{StaticResource GhostIconButton}"
                                            Width="22" Height="22"
                                            Click="AssistantCloseButton_Click" ToolTip="닫기 (Esc)">
                                        <Path Data="M18 6L6 18M6 6l12 12"
                                              Stroke="#A8A8AD" StrokeThickness="2.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="10" Height="10" Stretch="Uniform"/>
                                    </Button>
                        </StackPanel>

                        <!-- Notification Expanded -->
                        <Grid x:Name="NotificationExpandedView" Opacity="0" IsHitTestVisible="False"
                              Margin="20,16,20,16" VerticalAlignment="Top" HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="NotifExpandedAppText" Grid.Row="0" Text="App Name"
                                       Foreground="#0A84FF" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system"/>
                            <TextBlock x:Name="NotifExpandedTitleText" Grid.Row="1" Text="Notification Title"
                                       Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="44"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system" Margin="0,0,0,4"/>
                            <TextBlock x:Name="NotifExpandedBodyText" Grid.Row="2" Text="Body text here..."
                                       Foreground="#E5FFFFFF" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" MaxHeight="80" TextTrimming="WordEllipsis"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system"/>
                        </Grid>

                        <!-- Idle expanded: 얼굴 + 배터리 퍼센트 한 줄 (텍스트·버튼 최소화) -->
                        <StackPanel x:Name="IdleExpandedView" Opacity="0" IsHitTestVisible="False"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <controls:AiFace x:Name="ExpandedFace" Width="58" Height="40"
                                             HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        Margin="0,12,0,0" Visibility="Collapsed" x:Name="ExpandedBatteryPanel">
                                <Ellipse x:Name="ExpandedBatteryDot" Width="6" Height="6"
                                         Fill="#34C759" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ExpandedBatteryText" Text=""
                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="#A8A8AD" FontSize="12" FontWeight="Medium"
                                           FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Media compact -->
                        <Grid x:Name="MediaCompactView" Opacity="0" IsHitTestVisible="False"
                              Margin="14,0,14,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CompactTitleText" Grid.Column="0" Text="재생 중인 미디어 없음"
                                       Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system"
                                       LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                       VerticalAlignment="Center" Margin="0,-2,14,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="CompactLyricText" Grid.Column="1" Text=""
                                       Foreground="#8E8E93" FontSize="13" FontWeight="Medium"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system"
                                       LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Margin="0,-2,0,0" TextTrimming="CharacterEllipsis"/>
                            <StackPanel x:Name="EqualizerPanel" Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="10,0,0,0">
                                <Border x:Name="EqBar1" Width="2.5" Height="3" CornerRadius="1.25"
                                        Background="#FF9F0A" Margin="1,0,1,0" VerticalAlignment="Center"/>
                                <Border x:Name="EqBar2" Width="2.5" Height="3" CornerRadius="1.25"
                                        Background="#FF9F0A" Margin="1,0,1,0" VerticalAlignment="Center"/>
                                <Border x:Name="EqBar3" Width="2.5" Height="3" CornerRadius="1.25"
                                        Background="#FF9F0A" Margin="1,0,1,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Media expanded -->
                        <Grid x:Name="MediaExpandedView" Opacity="0" IsHitTestVisible="False"
                              Margin="16,16,16,16" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition x:Name="LyricsDividerCol" Width="Auto"/>
                                <ColumnDefinition x:Name="LyricsCol" Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Album art + title -->
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="54" Height="54" CornerRadius="14"
                                            Margin="0,0,12,0" VerticalAlignment="Center"
                                            Background="#1C1C1E" BorderBrush="#25FFFFFF" BorderThickness="0.5">
                                        <Border.OpacityMask>
                                            <VisualBrush>
                                                <VisualBrush.Visual>
                                                    <Border Width="54" Height="54" CornerRadius="14" Background="Black"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Border.OpacityMask>
                                        <Grid>
                                            <Image x:Name="ExpandedAlbumArtImage" Stretch="UniformToFill"/>
                                            <Path x:Name="ExpandedDefaultIcon"
                                                  Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                                  Fill="#FA233B" Width="22" Height="22" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="ExpandedTitleText" Text="재생 중인 미디어 없음"
                                                   Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="ExpandedArtistText" Text="" Foreground="#98989D"
                                                   FontSize="12" FontWeight="Medium"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Progress bar -->
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <ProgressBar x:Name="ExpandedProgressBar"
                                                     Style="{StaticResource AppleProgressBar}"
                                                     Height="4" Minimum="0" Maximum="100" Value="0"/>
                                        <!-- 스폰서/인트로 등 스킵 구간 마커 (진행바 위에 겹쳐 그림) -->
                                        <Canvas x:Name="ProgressMarkerCanvas" Height="4"
                                                VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,5,0,0">
                                        <TextBlock x:Name="CurrentTimeText" Text="0:00"
                                                   Foreground="#8E8E93" FontSize="10" FontWeight="SemiBold"
                                                   HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="TotalTimeText" Text="0:00"
                                                   Foreground="#8E8E93" FontSize="10" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>

                                <!-- Controls -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Style="{StaticResource AppleButton}" Click="PrevButton_Click"
                                            Width="36" Height="36" Margin="0,0,18,0">
                                        <Path Data="M6 6h2v12H6zm3.5 6l8.5 6V6z"
                                              Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform"/>
                                    </Button>
                                    <Button Style="{StaticResource PlayCircleButton}" Click="PlayPauseButton_Click"
                                            Width="42" Height="42" Margin="0,0,18,0" Cursor="Hand">
                                        <Path x:Name="PlayPauseIcon" Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z"
                                              Fill="#FFFFFF" Width="15" Height="15" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource AppleButton}" Click="NextButton_Click"
                                            Width="36" Height="36">
                                        <Path Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"
                                              Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform"/>
                                    </Button>
                                    <Button x:Name="SponsorSkipButton"
                                            Visibility="Collapsed" Click="SponsorSkipButton_Click"
                                            Height="26" Margin="10,0,0,0" Cursor="Hand"
                                            VerticalAlignment="Center" ToolTip="스폰서 구간 건너뛰기">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="skipBg" Background="#22FF9F0A" CornerRadius="13" Padding="12,0">
                                                    <TextBlock Text="건너뛰기" FontSize="11" FontWeight="SemiBold" Foreground="#FFB84D"
                                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="skipBg" Property="Background" Value="#38FF9F0A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Rectangle x:Name="LyricsDivider" Grid.Column="1"
                                       Fill="#12FFFFFF" Width="1" Margin="16,10,18,10" Visibility="Collapsed"/>

                            <Grid x:Name="LyricsContainer" Grid.Column="2" VerticalAlignment="Center" Visibility="Collapsed">
                                <StackPanel x:Name="LyricsPanel">
                                    <TextBlock x:Name="PrevLyricText" Text="" Foreground="#555558"
                                               FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6"
                                               FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system"/>
                                    <TextBlock x:Name="CurrentLyricText" Text="" Foreground="#FFFFFF"
                                               FontSize="15" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="44"
                                               Margin="0,0,0,4"
                                               FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system"/>
                                    <TextBlock x:Name="NextLyricText" Text="" Foreground="#88888C"
                                               FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system"/>
                                </StackPanel>
                            </Grid>

                            <!-- 클립보드 히스토리 토글 (미디어 확장 우상단) -->
                            <Button x:Name="ClipboardToggleButton" Grid.ColumnSpan="3"
                                    Style="{StaticResource GhostIconButton}" Width="22" Height="22"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-6,-4,0"
                                    Click="ClipboardToggleButton_Click" ToolTip="클립보드 기록">
                                <Path Data="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2M9 2h6a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z"
                                      Stroke="#A8A8AD" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="11" Height="11" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                    </Grid>

                    <!-- 클립보드 히스토리 스트립 (확장 뷰 하단 오버레이, 행 클릭 시 다시 복사) -->
                    <Border x:Name="ClipboardStripPanel" Visibility="Collapsed" Opacity="0"
                            VerticalAlignment="Bottom" Margin="16,6,16,12"
                            Background="#D9121214" CornerRadius="10" Padding="12,9,12,9">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ClipboardStripTransform" Y="-10"/>
                        </Border.RenderTransform>
                        <StackPanel>
                            <TextBlock Text="CLIPBOARD" FontSize="9.5" FontWeight="SemiBold" Foreground="#8E8E93"
                                       HorizontalAlignment="Left" Margin="2,0,0,4"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            <Border x:Name="ClipboardRow1" Style="{StaticResource ClipRowStyle}" Margin="0,1,0,1"
                                    MouseLeftButtonUp="ClipboardRow_Click">
                                <TextBlock x:Name="ClipboardRowText1" FontSize="12" Foreground="#E5FFFFFF"
                                           TextTrimming="CharacterEllipsis"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            </Border>
                            <Border x:Name="ClipboardRow2" Style="{StaticResource ClipRowStyle}" Margin="0,1,0,1"
                                    MouseLeftButtonUp="ClipboardRow_Click">
                                <TextBlock x:Name="ClipboardRowText2" FontSize="12" Foreground="#E5FFFFFF"
                                           TextTrimming="CharacterEllipsis"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            </Border>
                            <Border x:Name="ClipboardRow3" Style="{StaticResource ClipRowStyle}" Margin="0,1,0,1"
                                    MouseLeftButtonUp="ClipboardRow_Click">
                                <TextBlock x:Name="ClipboardRowText3" FontSize="12" Foreground="#E5FFFFFF"
                                           TextTrimming="CharacterEllipsis"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            </Border>
                            <Border x:Name="ClipboardRow4" Style="{StaticResource ClipRowStyle}" Margin="0,1,0,1"
                                    MouseLeftButtonUp="ClipboardRow_Click">
                                <TextBlock x:Name="ClipboardRowText4" FontSize="12" Foreground="#E5FFFFFF"
                                           TextTrimming="CharacterEllipsis"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            </Border>
                            <Border x:Name="ClipboardRow5" Style="{StaticResource ClipRowStyle}" Margin="0,1,0,1"
                                    MouseLeftButtonUp="ClipboardRow_Click">
                                <TextBlock x:Name="ClipboardRowText5" FontSize="12" Foreground="#E5FFFFFF"
                                           TextTrimming="CharacterEllipsis"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Volume bar panel (bottom) -->
                    <Border x:Name="VolumeBarPanel" Visibility="Collapsed" Opacity="0"
                            VerticalAlignment="Bottom" Margin="16,6,16,12"
                            Background="#D9121214" CornerRadius="10" Padding="12,9,12,9">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="VolumeBarTransform" Y="-10"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="VolumeBarIcon" Grid.Column="0"
                                  Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"
                                  Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform"
                                  Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <ProgressBar x:Name="VolumeBarProgressBar" Grid.Column="1"
                                         Style="{StaticResource AppleVolumeProgressBar}"
                                         Height="6" Minimum="0" Maximum="100" Value="50" VerticalAlignment="Center"/>
                            <TextBlock x:Name="VolumeBarText" Grid.Column="2" Text="50%"
                                       Foreground="#E5FFFFFF" FontSize="11" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system"/>
                        </Grid>
                    </Border>

                    <!-- 배터리 상태 점 (접힌 기본 아일랜드 전용)
                         일반=안 그림 / 충전 중=녹색 + 은은한 pulse / 부족=적색 고정 -->
                    <Grid x:Name="BatteryDot" Width="12" Height="12"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,12,0" Visibility="Collapsed" IsHitTestVisible="False">
                        <Ellipse x:Name="BatteryDotGlow" Width="12" Height="12"
                                 Opacity="0.3" Fill="#34C759"/>
                        <Ellipse x:Name="BatteryDotCore" Width="5" Height="5" Fill="#34C759"/>
                    </Grid>

                </Grid>
            </Border>

            <!-- 본체 '위'에 얹히는 오버레이: 원본 beam은 콘텐츠 위에서 빛나므로
                 안쪽으로 퍼지는 글로우가 보인다. NotchBorder 뒤에 두면 inner 레이어가 가려진다. -->
            <controls:BorderBeam x:Name="NotchBeam" Width="100" Height="38"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 CornerRadius="19" BorderWidth="1.2" Strength="0.9" Active="True"/>
        </Grid>

        <!-- 클립보드 사이드 캡슐: 레이아웃 완전 분리(Canvas) — 노치 컨테이너 폭에 영향 없음.
             외형은 DarkNotchStyle(아일랜드)과 동일한 배경/테두리/그림자. 위치는 코드에서 실측. -->
        <Canvas IsHitTestVisible="True">
            <Border x:Name="ClipboardSideCapsule" Canvas.Left="0" Canvas.Top="0"
                    Height="40" CornerRadius="20" ClipToBounds="True"
                    Background="#0C0C0E" BorderThickness="1"
                    Style="{StaticResource DarkNotchStyle}"
                    RenderTransformOrigin="0,0.5"
                    Cursor="Hand"
                    MouseLeftButtonUp="ClipboardSideCapsule_Click"
                    Visibility="Collapsed" Opacity="0">
                <Border.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="ClipboardSideTransform" X="0"/>
                        <TranslateTransform x:Name="ClipboardSideDropTransform" Y="0"/>
                        <!-- DPI 정규화: 코드에서 1.75/배율로 설정 — 노트북 175%에서 본 크기를 어느 모니터에서든 유지 -->
                        <ScaleTransform x:Name="ClipboardSideDpiScale" ScaleX="1" ScaleY="1"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                          Fill="#0A84FF" Width="13" Height="13" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="16,0,9,0"/>
                    <TextBlock x:Name="ClipboardSideText" Text=""
                               Foreground="#E8FFFFFF" FontSize="13.5" FontWeight="Medium"
                               FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                </StackPanel>
            </Border>
            <!-- 클립보드 기록 패널: 캡슐 클릭 시 아래로 펼쳐지는 최근 5개 목록 -->
            <Border x:Name="ClipboardHistoryPanel" Canvas.Left="0" Canvas.Top="0"
                    MaxWidth="300" CornerRadius="14"
                    Background="#0C0C0E" BorderThickness="1"
                    Style="{StaticResource DarkNotchStyle}"
                    RenderTransformOrigin="0,0"
                    Visibility="Collapsed" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ClipboardHistoryTransform" Y="0"/>
                </Border.RenderTransform>
                <StackPanel x:Name="ClipboardHistoryRows" Margin="6"/>
            </Border>
        </Canvas>
    </Grid>
</Window>
